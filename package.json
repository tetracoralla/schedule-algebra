{
  "name": "schedule-algebra",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Bounded interval and recurrence algebra for humans and Agents.",
  "bin": {
    "schedule-algebra": "dist/cli.js",
    "schedule-algebra-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:plugin",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "check": "npm run build && npm run test && npm run check:repo && npm run check:plugin",
    "check:plugin": "node scripts/check-plugin.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "cli": "npm run build:ts --silent && node dist/cli.js",
    "mcp": "npm run build:ts --silent && node dist/mcp.js",
    "measure:baseline": "npm run build:ts --silent && node scripts/measure-baseline.mjs",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ui": "npm run build:ts --silent && node dist/http.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "rrule": "2.8.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "esbuild": "0.25.12",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
